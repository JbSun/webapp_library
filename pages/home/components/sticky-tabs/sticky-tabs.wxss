.tab-bar {
  display: flex;
  background-color: #fff;
  height: 50px;
  z-index: 999;
}
.tab-bar.fixed {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.1);
}
.tab-item {
  flex: 1;
  text-align: center;
  line-height: 50px;
}
.tab-item.active {
  font-weight: bold;
  border-bottom: 2px solid #007aff;
}
.swiper-container {
  height: calc(100vh - 50px);
}
.tab-content {
  height: 100%;
}
.news-item {
  padding: 20rpx;
  border-bottom: 1px solid #f0f0f0;
}
.loading {
  text-align: center;
  padding: 20rpx;
  color: #999;
}

.book-list-container {
  background-color: #fff;
  box-sizing: border-box;
  width: 100%;
  display: flex;
  height: 100%;
  /* gap: 48rpx; */
  flex-direction: column;
}

.book-list__item {
  display: flex;
  padding: 24rpx;
  border-top: 1rpx solid #eee;
}

.book-list__item-image {
  width: 100rpx;
  height: 160rpx;
  margin-right: 48rpx;
  flex-basis: 100rpx;
  flex-shrink: 0;
}

.book-list__item-message {
  display: flex;
  justify-content: center;
  flex-direction: column;
  gap: 12rpx;
}

.book-list__item-message_title {
}

.book-list__item-message_authors {
  display: flex;
  gap: 12rpx;
  flex-flow: wrap;
}

.book-list__item-message_author {
  color: #a6aeb5;
}
