.showcase-container {
  box-sizing: border-box;
  padding: 30rpx;
  width: 100%;
  background: #fff;
}

.showcase-popular-container {
  box-sizing: border-box;
  padding: 20rpx;
  width: 100%;
  background: #a6aeb5;
}

.showcase {
  display: flex;
  display: -webkit-flex;
  flex-direction: row;
}

.showcase__item {
  position: relative;
  width: 200rpx;
  margin-right: 47rpx;
}

.showcase__popular-item {
  position: relative;
  width: 120rpx;
  margin-right: 27rpx;
}

/*  
 * TODO --- 这里想让作者名字紧贴底部，但是没实现 

.showcase__item-author {
  position: relative;
  bottom: 0;
}
*/

.showcase__item-image--book {
  width: 200rpx;
  height: 285rpx;
}

.showcase__item-popular-image--book {
  width: 120rpx;
  height: 171rpx;
}

.showcase__item-image--booklist {
  width: 200rpx;
  height: 200rpx;
}

.showcase-book-list-container {
  box-sizing: border-box;
  /* padding: 20rpx; */
  width: 100%;
}

.showcase-book-list {
  width: 100%;
  display: flex;
  gap: 48rpx;
  flex-direction: column;
}

.showcase-book-list__item {
  display: flex;
  gap: 48 rpx;
  padding-bottom: 24rpx;
  border-bottom: 1rpx solid #EEE;
}

.showcase-book-list__item-image {
  width: 100rpx;
  height: 160rpx;
}

.showcase-book-list__item-message {
  display: flex;
  justify-content: center; 
  flex-direction: column;
  gap:12rpx;
}